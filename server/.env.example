PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db_name>
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://your-netlify-site.netlify.app
REDIS_URL=redis://127.0.0.1:6379
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
SEED_ON_START=false
SEED_DEMO_DATA=false
SEED_CUSTOMER_EMAILS=demo.customer@example.test
SEED_CUSTOMER_PASSWORD=replace_with_a_unique_strong_password
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@smartdelivery.local
SEED_ADMIN_PASSWORD=replace_with_a_unique_strong_password
SEED_DELIVERY_PARTNERS=partner1@smartdelivery.local,partner2@smartdelivery.local
SEED_DELIVERY_PARTNER_PASSWORD=replace_with_a_unique_strong_password
